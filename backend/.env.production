# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ai_chat_db

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Optional: Vision model for image analysis (needs: ollama pull llava)
OLLAMA_VISION_MODEL=llava

# Optional: Stable Diffusion local URL (if running AUTOMATIC1111 or ComfyUI)
SD_API_URL=http://localhost:7860

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# CORS
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Redis (for caching)
REDIS_URL=redis://redis:6379



